{
  "name": "depth-image-react-three-fiber",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "pretty": "pretty-quick",
    "depth": "tsx make-depth.ts",
    "deploy": "nr build && nr gh-pages -d dist && echo \"https://ax-sh.github.io/depth-image-react-three-fiber\"",
    "format": "nlx @biomejs/biome format --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.1.2",
    "@tailwindcss/vite": "^4.1.7",
    "@tanstack/react-query": "^5.77.2",
    "@types/three": "^0.176.0",
    "@xenova/transformers": "^2.17.2",
    "comlink": "^4.4.2",
    "leva": "^0.10.0",
    "mockjs": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "tailwindcss": "^4.1.7",
    "three": "^0.176.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^9.27.0",
    "@tanstack/eslint-plugin-query": "^5.78.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/bun": "^1.2.14",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/ui": "^3.1.4",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.2.0",
    "happy-dom": "^17.4.7",
    "jsdom": "^26.1.0",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-plugin-comlink": "^5.1.0",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-qrcode": "^0.2.4",
    "vitest": "^3.1.4"
  },
  "packageManager": "bun@1.2.14"
}
