{
  "name": "depth-image-react-three-fiber",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "pretty": "pretty-quick",
    "depth": "tsx make-depth.ts",
    "deploy": "nlx build && gh-pages -d dist",
    "format": "nlx @biomejs/biome format --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-three/drei": "^9.112.0",
    "@react-three/fiber": "^8.17.7",
    "@tailwindcss/vite": "^4.1.7",
    "@types/three": "^0.176.0",
    "@xenova/transformers": "^2.17.2",
    "leva": "^0.10.0",
    "mockjs": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.7",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^9.27.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/bun": "^1.2.14",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "happy-dom": "^17.4.7",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-qrcode": "^0.2.4",
    "vitest": "^3.1.4"
  },
  "packageManager": "bun@1.2.14"
}
